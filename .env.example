# ========== PostgreSQL ==========
POSTGRES_DB=campuslab
POSTGRES_USER=campuslab
POSTGRES_PASSWORD=campuslab
POSTGRES_PORT=5432

# ========== RabbitMQ ==========
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ========== Kafka ==========
KAFKA_PORT=9092
KAFKA_CONTROLLER_PORT=9093

# ========== Spring Boot Profiles ==========
SPRING_PROFILES_ACTIVE=docker

# ========== Microservicios Backend - Puertos ==========
BOOKINGS_PORT=8082
CATALOG_PORT=8081
AUDIT_PORT=8083
NOTIFY_PORT=8084
REPORT_PORT=8085

# ========== Frontend ==========
FRONTEND_PORT=4200
# Para desarrollo local
API_URL=http://3.238.17.63:8082
# Para EC2 (reemplaza con tu IP pública de EC2)
# API_URL=hhttp://3.238.17.63:8082

# ========== URLs Internas de Servicios ==========
# Usadas dentro de los contenedores
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
RABBITMQ_HOST=rabbitmq
POSTGRES_HOST=postgres
CATALOG_BASE_URL=http://ms-campuslab-catalog:8081
