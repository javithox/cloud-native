# ========== EC2 Configuration ==========
# IP Pública de EC2: 32.192.223.53

# ========== PostgreSQL ==========
POSTGRES_DB=campuslab
POSTGRES_USER=campuslab
POSTGRES_PASSWORD=campuslab
POSTGRES_PORT=5432

# ========== RabbitMQ ==========
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ========== Kafka ==========
KAFKA_PORT=9092
KAFKA_CONTROLLER_PORT=9093

# ========== Spring Boot Profiles ==========
SPRING_PROFILES_ACTIVE=docker

# ========== Microservicios Backend - Puertos ==========
BOOKINGS_PORT=8082
CATALOG_PORT=8081
AUDIT_PORT=8083
NOTIFY_PORT=8084
REPORT_PORT=8085

# ========== Frontend ==========
FRONTEND_PORT=4200
API_URL=http://32.192.223.53:8082

# ========== URLs Internas de Servicios ==========
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
RABBITMQ_HOST=rabbitmq
POSTGRES_HOST=postgres
CATALOG_BASE_URL=http://ms-campuslab-catalog:8081
